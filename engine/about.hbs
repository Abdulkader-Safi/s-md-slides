<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>s-md-slides third-party notices</title>
<style>body{font:15px/1.5 system-ui,sans-serif;max-width:60rem;margin:2rem auto;padding:0 1rem}pre{white-space:pre-wrap;background:#f4f4f5;padding:1rem}</style>
</head>
<body>
<h1>Third-party notices</h1>
<p>The s-md-slides engine includes the crates below. The bundled Noto fonts are under the SIL Open Font License 1.1, in <code>crates/render/assets/fonts/OFL.txt</code>.</p>
<ul>
{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<p>Used by:</p>
<ul>{{#each used_by}}<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>{{/each}}</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
